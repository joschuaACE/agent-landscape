# --- Persistence -----------------------------------------------------------
# SQLite file (missions, agents, tasks, regions …). "off" = in-memory only.
# Mock mode uses data/landscape-mock.db unless DB_PATH is set.
# DB_PATH=data/landscape.db

# --- Server ---------------------------------------------------------------
HOST=127.0.0.1
PORT=8765
# URL other agents use to reach this server (defaults to http://127.0.0.1:$PORT)
# PUBLIC_URL=http://127.0.0.1:8765

# --- Models (any LiteLLM model string) -------------------------------------
# With a LiteLLM proxy use the model's PUBLIC name (bold in the LiteLLM UI / `model_name`),
# not the underlying provider model shown below it (`litellm_params.model`).
DEFAULT_MODEL=bc2_claude-haiku-5-5
# ORCHESTRATOR_MODEL=gpt-4o

# Option A: call providers directly through the LiteLLM SDK
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=...

# Option B: route everything through a LiteLLM Proxy (recommended)
# Models are then called as "litellm_proxy/<DEFAULT_MODEL>".
# LITELLM_PROXY_URL=http://localhost:4000
# LITELLM_PROXY_API_KEY=sk-litellm-...

# Mock mode: "auto" (on if no proxy / provider key found), "true" or "false".
# Uses LiteLLM's mock_response, so the full pipeline runs without spending tokens.
MOCK_LLM=auto

# --- Vector stores (knowledge bases) ---------------------------------------
# Orchestrators create/link stores named al-<region>-<purpose>; sub-agents search them.
# Completed missions are archived into al-<region>-knowledge (set VECTOR_STORE_AUTO_ARCHIVE=false to disable).
# VECTOR_STORE_URL=http://localhost:8000
# VECTOR_STORE_KEY=sk-...
# VECTOR_STORE_PARSER=markitdown
# VECTOR_STORE_PREFIX=al
# VECTOR_STORE_AUTO_ARCHIVE=true
# Command HQ recalls the top-N related past missions from all region archives for every new mission (0 = off)
# VECTOR_STORE_RECALL=5
# VECTOR_STORE_RECALL_MIN_SCORE=0
# Exported mission reports imported into the region knowledge bases on startup (off = disabled)
# MISSION_ARCHIVE_DIR=mission-archive

# --- Agent profiles & skills ----------------------------------------------
# Profiles (system instructions, prompts, model, tool access) in PROFILES_DIR override built-ins by key.
# PROFILES_DIR=profiles
# Skill folders (<dir>/<name>/SKILL.md), ':'-separated.
# SKILLS_DIRS=skills:.github/skills:.claude/skills

# --- Git repositories --------------------------------------------------------
# Registry of repos (versioned) + workspace for clones and per-mission worktrees (gitignored).
# Clones use your git credential helper / SSH agent – no tokens are stored here.
# REPOS_FILE=repos.yaml
# WORKSPACE_DIR=workspace

# --- Mission context -------------------------------------------------------
# Folders agents may read when you attach them (read-only). Separate with ":" (default: your home dir)
# CONTEXT_ROOTS=/Users/you/git:/Users/you/Documents
# MAX_TOOL_STEPS=6
# run_check (tests / coverage / lint / dead_code in mission worktrees) – needs: uv pip install -e '.[checks]'
# CHECKS_PYTHON=/path/to/python   # default: this server's interpreter
# CHECKS_TIMEOUT=300

# --- Orchestration limits -------------------------------------------------
MAX_DEPTH=3
MAX_SUBTASKS=4
DEFAULT_SWARM_SIZE=3
MAX_SWARM_SIZE=6
MAX_AGENTS=80

# --- Operations team (always-on, read-only Outlook / Teams monitors) ---
# folder = JSON files from Power Automate flows in OneDrive (AgentInbox/mail, teams/channels, teams/chats)
# mock = simulated feed, off = disabled
OPS_SOURCE=mock
# OPS_INBOX_DIR=~/Library/CloudStorage/OneDrive-<Company>/AgentInbox   # auto-detected if unset
# OPS_BACKLOG_HOURS=24      # first start: also triage messages of the last N hours
# OPS_IGNORE_SENDERS=Your Name,you@company.com   # never forward your own messages
# OPS_POLL_SECONDS=15
# OPS_MOCK_INTERVAL=120   # mean seconds between simulated messages per channel

# --- Teams (teams.yaml: lead + specialists + repos + standing orders, optional cron schedule) ---
# TEAMS_FILE=teams.yaml        # off = no teams
# TEAMS_SCHEDULER=on           # off = scheduled teams only run via ▶ Run now
# TEAMS_CATCH_UP_HOURS=12      # after downtime, a missed run is started once if not older than this
